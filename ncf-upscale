#!/bin/sh
set -eu
APP_HOME="${NCF_IMAGE_UPSCALER_HOME:-$HOME/Library/Application Support/ncf-image-upscaler}"
PYTHON="$APP_HOME/runtime/env/bin/python"
if [ ! -x "$PYTHON" ]; then
    printf '%s\n' 'NCF Image Upscaler is not installed. Run scripts/install.sh from the project folder.' >&2
    exit 1
fi
exec "$PYTHON" -m ncf_image_upscaler "$@"

