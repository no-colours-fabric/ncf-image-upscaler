#!/bin/sh
set -eu
APP_HOME="${IMAGE_UPSCALER_HOME:-$HOME/Library/Application Support/image-upscaler}"
PYTHON="$APP_HOME/runtime/env/bin/python"
if [ ! -x "$PYTHON" ]; then
    printf '%s\n' 'Image Upscaler is not installed. Run scripts/install.sh from the project folder.' >&2
    exit 1
fi
exec "$PYTHON" -m image_upscaler "$@"

